{
  "name": "family-todos",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run .output/server/index.mjs",
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "serve": "bun --bun vite preview",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:start": "docker compose up -d db",
    "db:stop": "docker compose down",
    "db:rm": "docker compose down -v",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "docker:build": "docker compose build app",
    "docker:up": "docker compose --profile full up -d",
    "docker:down": "docker compose --profile full down",
    "docker:logs": "docker compose --profile full logs -f"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/react-devtools": "^0.8.2",
    "@tanstack/react-form": "^1.27.1",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@tanstack/react-router": "^1.139.14",
    "@tanstack/react-router-devtools": "^1.139.14",
    "@tanstack/react-router-ssr-query": "^1.139.14",
    "@tanstack/react-start": "^1.139.14",
    "@tanstack/router-plugin": "^1.139.14",
    "@tanstack/zod-form-adapter": "^0.42.1",
    "adhan": "^4.4.3",
    "canvas-confetti": "^1.9.4",
    "drizzle-orm": "^0.45.0",
    "lucide-react": "^0.556.0",
    "next-themes": "^0.4.6",
    "nitro": "latest",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "resend": "^6.5.2",
    "tailwindcss": "^4.1.17",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.1.13",
    "zustand": "^5.0.9"
