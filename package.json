    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "drizzle-kit": "^0.31.8",
    "jsdom": "^27.2.0",
    "playwright": "^1.57.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "web-vitals": "^5.1.0"
  }
