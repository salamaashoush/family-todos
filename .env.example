# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/family_todos

# Default super admin (optional - uses admin/admin123 if not set)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=changeme123

# Session secret (must be at least 32 characters in production)
SESSION_SECRET=change-this-to-a-random-secret-at-least-32-characters-long-for-production

# Server
PORT=3000
